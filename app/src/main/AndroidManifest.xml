<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Server discovery via UDP broadcast on the local network -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Whether the phone has a network at all, for the cloud in the library -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Added by media3 (Readium's audiobook support), which Librifin doesn't use -->
    <uses-permission android:name="android.permission.WAKE_LOCK" tools:node="remove" />

    <!-- usesCleartextTraffic: home Jellyfin servers usually run on plain http:// in the LAN. Fine at home, but over
         http:// anyone on the same network can read the traffic, including the login, so use https:// elsewhere. -->
    <application
        android:name=".LibrifinApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Librifin">
        <!-- Opened through the launcher entries below. Still exported: a task in Recents that was opened before they
             existed points to it directly. -->
        <activity
            android:exported="true"
            android:name=".MainActivity" />
        <!-- One launcher entry per app icon (AppIcon.kt), declared after the activity they open, as Android requires.
             The app switches exactly one of them on. Android remembers which by these names, so they must never
             change. android:icon is enough: Android takes it on devices with round icons too, as the entries have no
             android:roundIcon. -->
        <activity-alias
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:name=".DarkIcon"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_light"
            android:name=".LightIcon"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity
            android:name="androidx.media3.session.BluetoothValidationActivity"
            tools:node="remove" />
    </application>

</manifest>